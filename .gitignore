# Keep local helper scripts ignored while tracking the release staging entry points.
/cmake/*
!/cmake/stage_release_package.cmake
!/cmake/qt_deploy_mapping.cmake
!/cmake/runtime_data.cmake
!/cmake/tests/
/cmake/tests/*
!/cmake/tests/stage_release_package_tests.cmake
!/cmake/tests/qt_deploy_mapping_case.cmake
!/cmake/tests/qt_deploy_mapping_tests.cmake
